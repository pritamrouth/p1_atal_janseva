# Copy to .env and fill in real values.
# Variable names match the original atal_janseva backend, so the same .env works.
# Note: WA_PROVIDER / PLIVO_* variables from the old backend are ignored here –
# this service always sends through the Meta WhatsApp Cloud API.

# ── Meta (WhatsApp Cloud API) ──────────────────────────────────────────────────
WA_PHONE_NUMBER_ID=1234567890
WA_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxx
WA_VERIFY_TOKEN=my_super_secret_verify_token_2024

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:password@localhost:5432/ataljanseva?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10

# ── Redis (local) ──────────────────────────────────────────────────────────────
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Worker pool ────────────────────────────────────────────────────────────────
# 50 workers handles ~1000 concurrent conversations comfortably.
WORKER_COUNT=50
QUEUE_DEPTH=2000

# ── Inactivity Monitoring ──────────────────────────────────────────────────────
# When enabled (default: true), user sessions are deleted after 90 seconds (1.5 min)
# of inactivity. No message is sent to the user. Next message starts fresh.
# Set to "false" to keep sessions alive indefinitely (not recommended).
ENABLE_INACTIVITY_MONITOR=true

# ── AtalJanseva public REST API ────────────────────────────────────────────────
# Backs complaints, tracking, appointments and the info menu (options 1-9, 12).
# Public endpoints, no auth. Leave blank for production.
# ATALJANSEVA_API_BASE_URL=https://api.ataljanseva.in
# Local backend: http://localhost:3000
ATALJANSEVA_API_TIMEOUT=10

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=8080
ENV=development   # set to "production" for JSON logs
